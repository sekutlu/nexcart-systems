{
  "buildCommand": "npm run build -w @nexcart/web",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "rootDirectory": ".",
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "NEXT_PUBLIC_API_URL": "@next_public_api_url"
  }
}

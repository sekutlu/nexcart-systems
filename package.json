{
  "name": "nexcart-systems",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nexcart/web",
    "dev:web": "npm run dev -w @nexcart/web",
    "dev:mobile": "npm run start -w @nexcart/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint -w @nexcart/web",
    "db:generate": "npm run db:generate -w @nexcart/web",
    "db:migrate": "npm run db:migrate -w @nexcart/web",
    "db:studio": "npm run db:studio -w @nexcart/web"
  },
  "overrides": {
    "react-native-reanimated": "~3.10.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "ajv": "^8.20.0",
    "typescript": "^5.4.5"
  }
}

{
  "expo": {
    "name": "Datamak NexCart",
    "slug": "nexcart-mobile",
    "scheme": "nexcart",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "co.ls.datamak.nexcart"
    },
    "ios": {
      "bundleIdentifier": "co.ls.datamak.nexcart",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
